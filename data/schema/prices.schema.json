{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video-generation-prices",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "as_of": { "type": ["string", "null"], "format": "date" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vendor": { "type": "string" },
          "model": { "type": "string" },
          "price": { "type": "string", "description": "原值原样，如 '0.40' 或 '1.5'" },
          "unit": { "type": "string", "description": "second | video | token | request" },
          "currency": { "type": "string", "description": "USD | CNY | credits 等，原样记录不换算" },
          "tiers": { "type": "string", "description": "档位差异说明（分辨率/时长/速度档）" },
          "url_validity": { "type": "string", "description": "产物 URL 有效期，如 24h / 7d / permanent" },
          "source_url": { "type": "string", "format": "uri" },
          "confidence": { "type": "string", "enum": ["官方源", "多源交叉", "单一来源"] },
          "notes": { "type": "string", "description": "隐性成本：余额门槛、最小计费单位、加价模式等" }
        },
        "required": ["vendor", "model", "price", "unit", "currency", "source_url", "confidence"]
      }
    },
    "normalization_notes": { "type": "string" },
    "sources": {
      "type": "array",
      "items": { "type": "object", "properties": { "title": { "type": "string" }, "url": { "type": "string" } }, "required": ["title", "url"] }
    }
  },
  "required": ["as_of", "entries", "sources"]
}
